# GEMINI_API_KEY: Required for server-side Gemini AI API synthesis and manuscript drafting.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PORT: The port the server listens on (defaults to 3000, overridden by Cloud Run $PORT)
PORT=3000

# NODE_ENV: Set to "production" in production environments
NODE_ENV="production"

# APP_URL: The public URL where this applet is hosted
APP_URL="http://localhost:3000"
